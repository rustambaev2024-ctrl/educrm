[flake8]
# 120 не хватало только двуязычным строкам сообщений — переносить их по словам
# читаемости не добавляет. Всё остальное проверяется как раньше.
max-line-length = 160
extend-ignore = F401,F403,F405,W391
exclude = .git,__pycache__,node_modules,.venv,*/migrations/*

# Django-специфика: в urls.py импорты идут после настройки роутера, в
# settings/base.py — после вычисления путей. Это конвенция, а не ошибка.
per-file-ignores =
    config/urls.py:E402
    config/test_urls.py:E402
    config/settings/base.py:E402
